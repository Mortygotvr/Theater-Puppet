// Theater Puppet: the avatar's materials. A style's code (styles.rs) goes
// where STYLE_CODE is: its uniforms and `float4 style(Surface s)`.

uniform float4x4 mvp;
uniform texture2d image;
uniform float4 base_color;
uniform float4 shade_color;
// A colour slot's gradient (colorfx.rs): base_color / shade_color at the
// start of the way (top, the avatar's left, the front), grad_b / grad_shade_b
// at its end; along grad_axis, over grad_range (its parts at rest: lowest,
// highest); grad_b.w 0: off. grad_flow: a rainbow along it (its hue at the
// start, how much of the wheel, how much shows, the shade's ratio)
uniform float4 grad_b;
uniform float4 grad_shade_b;
uniform float4 grad_axis;
uniform float4 grad_range;
uniform float4 grad_flow;
uniform float use_texture;
uniform float alpha_cutoff;
uniform float blended;
uniform float4 light_dir;
// The light's colour x strength (white, 1: the light Puppet always had)
uniform float4 light_color;
uniform float4 eye;
uniform float outline_width;
uniform float4 outline_color;
uniform float outline_jitter;
uniform float outline_boil;
uniform float time;
// How much of its GLB shows (0–1): below 1 it dissolves, pixel by pixel
uniform float glb_fade;
// A tile crossfading (remote.rs): the tile before, where the UVs' tile maps
// to (uv * xy + zw), and how far the new one has come in (1 = all of it)
uniform float4 tile_map;
uniform float tile_mix;
// Where the base colour's placement (its tile) put the UVs (uv * xy + zw):
// undone for the other maps, which have none (glTF's placement is each
// texture's own): a face's normal map isn't cut to its colour's tile
uniform float4 uv_place;
// A reflection (the source's "Reflection" settings): an OBS source's picture,
// how much of it (0 = none), a flat picture (1) or a 360 one (0), and how the
// 360 one is turned (radians)
uniform float env_strength;
uniform float env_flat;
uniform float env_turn;
// As light (1: the picture lights the avatar from all around, as Blender's
// world does: no gloss) or as a mirror (0)
uniform float env_light;
// The material's other maps (glTF's): what it gives off (colour x texture),
// its normal map (tangent space, +Y up) and its gloss (metalness, roughness,
// x the metallic-roughness texture's blue and green). use_*: has that texture
uniform float4 emissive;
uniform texture2d emissive_tex;
uniform float use_emissive;
uniform texture2d normal_tex;
uniform float use_normal;
uniform float normal_scale;
uniform texture2d mr_tex;
uniform float use_mr;
uniform float metallic;
uniform float roughness;
// Its coat (Blender's Coat, glTF's clearcoat): how much, how rough
uniform float coat;
uniform float coat_roughness;
// OBS gives a shader's textures slots in the order they're declared; the
// compiler drops a texture whose value isn't used (a style that doesn't use
// roughness drops the roughness map) and numbers the rest: then every
// texture after it reads its neighbour's (black, or the normal map as the
// colour). keep_maps (never set: 0) keeps each map used, whatever the style
uniform float keep_maps;
uniform texture2d env;

sampler_state env_sampler {
	Filter   = Linear;
	AddressU = Wrap;
	AddressV = Clamp;
};

sampler_state tex_sampler {
	Filter   = Linear;
	AddressU = Wrap;
	AddressV = Wrap;
};

// The other maps, each with a sampler of its own (sharing tex_sampler with
// the colour texture made Direct3D read the colour texture as black)
sampler_state emissive_sampler {
	Filter   = Linear;
	AddressU = Wrap;
	AddressV = Wrap;
};

sampler_state normal_sampler {
	Filter   = Linear;
	AddressU = Wrap;
	AddressV = Wrap;
};

sampler_state mr_sampler {
	Filter   = Linear;
	AddressU = Wrap;
	AddressV = Wrap;
};

struct VertIn {
	float4 pos  : POSITION;
	float3 norm : NORMAL;
	float2 uv   : TEXCOORD0;
	// Where it is at rest (a gradient runs along it)
	float4 rest : TEXCOORD4;
};

struct VertOut {
	float4 pos  : POSITION;
	float2 uv   : TEXCOORD0;
	float3 norm : TEXCOORD1;
	float3 wpos : TEXCOORD2;
	float3 rest : TEXCOORD3;
};

struct Surface {
	float4 albedo;
	float3 shade;
	float3 normal;
	float3 light;
	// The light's colour x strength (white unless the source has its own light)
	float3 light_color;
	float3 view;
	float2 uv;
	// The pixel, in the source's pixels from the top left
	float2 screen;
	// Seconds, for styles that move
	float time;
	// Its gloss (0–1), as Blender's Principled BSDF: metalness and roughness
	float metallic;
	float roughness;
	// What it gives off (added after the style, as Blender adds emission)
	float3 emission;
};

float4 texel(float2 uv)
{
	if (use_texture < 0.5)
		return float4(1.0, 1.0, 1.0, 1.0);
	float4 now = image.Sample(tex_sampler, uv);
	if (tile_mix >= 1.0)
		return now;
	float4 before = image.Sample(tex_sampler, uv * tile_map.xy + tile_map.zw);
	return lerp(before, now, saturate(tile_mix));
}

// A GLB fading: whether this pixel is gone yet (a fine noise, the same
// every frame, so it dissolves rather than flickers)
bool faded_out(float2 screen)
{
	if (glb_fade >= 1.0)
		return false;
	float n = frac(52.9829189 * frac(dot(floor(screen), float2(0.06711056, 0.00583715))));
	return n >= glb_fade;
}

// The studio a glossy surface reflects along `rv` (as Blender's world and
// lights): soft all around and brighter above, a softbox where the light is
// and a strip overhead. Their edges blur with `rough`: sharp spots on varnish
// and polish (seen even on flat faces, which a pinpoint highlight misses), a
// haze on matte. For the styles' gloss
float3 studio(float3 rv, float3 light, float3 light_color, float rough)
{
	float r = saturate(rough);
	float sky = lerp(saturate(rv.y * 0.5 + 0.5), 0.5, r);
	float3 c = float3(1.0, 1.0, 1.0) * sky * sky;
	float blur = 0.04 + r * 0.9;
	// (The same light spread wider is dimmer)
	float strength = 1.0 / (1.0 + r * 6.0);
	float box = smoothstep(cos(0.35 + blur), cos(max(0.35 - blur, 0.0)), dot(rv, normalize(light)));
	float strip = smoothstep(cos(0.45 + blur), cos(max(0.45 - blur, 0.0)), rv.y);
	return c + (light_color * box * 4.0 + strip * 2.0) * strength;
}

/* STYLE_CODE */

VertOut VSPuppet(VertIn v)
{
	VertOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), mvp);
	o.uv = v.uv;
	o.norm = v.norm;
	o.wpos = v.pos.xyz;
	o.rest = v.rest.xyz;
	return o;
}

// The normal map on normal `n`: its tangent frame from how the position and
// the UVs change across the pixel (no tangents needed). glTF's maps have +Y
// up the picture, and its UVs go down it: green is turned round
float3 mapped_normal(float3 n, float3 wpos, float2 uv, float3 m)
{
	float3 dp1 = ddx(wpos);
	float3 dp2 = ddy(wpos);
	float2 duv1 = ddx(uv);
	float2 duv2 = ddy(uv);
	float3 dp2perp = cross(dp2, n);
	float3 dp1perp = cross(n, dp1);
	float3 t = dp2perp * duv1.x + dp1perp * duv2.x;
	float3 b = dp2perp * duv1.y + dp1perp * duv2.y;
	float inv = rsqrt(max(max(dot(t, t), dot(b, b)), 1e-20));
	m.xy *= normal_scale;
	float3 mapped = normalize(t * inv * m.x - b * inv * m.y + n * m.z);
	return normalize(lerp(n, mapped, saturate(use_normal)));
}

// The reflection source's picture in direction `r` (the avatar's space)
float3 env_at(float3 r)
{
	float2 at;
	if (env_flat > 0.5) {
		// A flat picture, as a mirror ball facing the camera (the avatar's
		// left is the picture's right as the camera sees it)
		at = float2(0.5 + r.x * 0.5, 0.5 - r.y * 0.5);
	} else {
		// A 360 picture (equirectangular): around, and up and down
		float around = atan2(r.x, r.z) + env_turn;
		at = float2(frac(0.5 - around / 6.2831853), acos(clamp(r.y, -1.0, 1.0)) / 3.1415927);
	}
	return env.Sample(env_sampler, at).rgb;
}

// A hue (turns) at full colour, a little lifted (as colorfx.rs's)
float3 rainbow_hue(float h)
{
	float3 k = saturate(abs(frac(h + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0);
	return 0.15 + k * 0.85;
}

// The mesh's own UVs: the base colour's placement undone
float2 own_uv(float2 uv)
{
	float2 s = float2(abs(uv_place.x) > 1e-6 ? uv_place.x : 1.0, abs(uv_place.y) > 1e-6 ? uv_place.y : 1.0);
	return (uv - uv_place.zw) / s;
}

float4 PSPuppet(VertOut v) : TARGET
{
	float4 t = texel(v.uv);
	// The other maps, read here in the order they're declared, on the mesh's own UVs
	float2 ouv = own_uv(v.uv);
	float3 emitted = emissive_tex.Sample(emissive_sampler, ouv).rgb;
	float3 nmap = normal_tex.Sample(normal_sampler, ouv).xyz * 2.0 - 1.0;
	float3 mrmap = mr_tex.Sample(mr_sampler, ouv).rgb;
	// A colour slot's gradient: from its start colour to its end one along the part at rest
	float4 bc = base_color;
	float3 sc = shade_color.rgb;
	if (grad_b.w > 0.5) {
		float along = dot(v.rest, grad_axis.xyz);
		// 0 at the start of the way (the top: the highest), 1 at its end
		float g = saturate((grad_range.y - along) / max(grad_range.y - grad_range.x, 1e-5));
		if (grad_axis.x > 0.5)
			g = 1.0 - g;
		bc.rgb = lerp(base_color.rgb, grad_b.rgb, g);
		sc = lerp(shade_color.rgb, grad_shade_b.rgb, g);
		if (grad_flow.z > 0.0) {
			float3 h = rainbow_hue(grad_flow.x + g * grad_flow.y);
			bc.rgb = lerp(bc.rgb, h, grad_flow.z);
			sc = lerp(sc, h * grad_flow.w, grad_flow.z);
		}
	}
	float4 albedo = bc * t;
	if (albedo.a < alpha_cutoff || faded_out(v.pos.xy))
		discard;
	Surface s;
	s.albedo = albedo;
	s.shade = sc * t.rgb;
	s.normal = mapped_normal(normalize(v.norm), v.wpos, ouv, nmap);
	float3 mr = lerp(float3(1.0, 1.0, 1.0), mrmap, saturate(use_mr));
	s.metallic = saturate(metallic * mr.b);
	s.roughness = saturate(roughness * mr.g);
	s.emission = emissive.rgb * lerp(float3(1.0, 1.0, 1.0), emitted, saturate(use_emissive));
	s.light = light_dir.xyz;
	s.light_color = light_color.rgb;
	s.view = normalize(eye.xyz - v.wpos);
	s.uv = v.uv;
	s.screen = v.pos.xy;
	s.time = time;
	float4 c = style(s);
	// What it gives off, over whatever the style made (Blender's emission)
	c.rgb += s.emission;
	// Its coat: clear varnish over whatever the style made, as Blender lays
	// it over the rest (its own normal: the surface's, not the normal map's).
	// 4% reflective at the front (IOR 1.5), more at grazing angles; what it
	// reflects dims what's under it
	if (coat > 0.0) {
		float3 cn = normalize(v.norm);
		float cr = clamp(coat_roughness, 0.03, 1.0);
		float ndv = saturate(dot(cn, s.view));
		float fres = (0.04 + 0.96 * pow(1.0 - ndv, 5.0)) * saturate(coat);
		float3 h = normalize(s.light + s.view);
		float ndh = saturate(dot(cn, h));
		float a2 = cr * cr * cr * cr;
		float dd = ndh * ndh * (a2 - 1.0) + 1.0;
		float sun = min(a2 / (3.14159265 * dd * dd), 50.0) * saturate(dot(cn, s.light)) * 0.25;
		float3 coat_light = studio(reflect(-s.view, cn), s.light, s.light_color, cr) + sun * s.light_color;
		c.rgb = c.rgb * (1.0 - fres) + coat_light * fres;
	}
	if (env_strength > 0.0) {
		if (env_light > 0.5) {
			// The picture as light: what each side of it faces, softened (the
			// sky around the normal, averaged), lights the material's colour,
			// added to the style's: a blue sky tints the top blue, a sunset
			// warms one side. No gloss
			float3 n = s.normal;
			float3 t = normalize(cross(abs(n.y) < 0.99 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0), n));
			float3 b = cross(n, t);
			float3 sky = env_at(n) * 2.0;
			sky += env_at(normalize(n + t * 0.9));
			sky += env_at(normalize(n - t * 0.9));
			sky += env_at(normalize(n + b * 0.9));
			sky += env_at(normalize(n - b * 0.9));
			sky += env_at(normalize(n + (t + b) * 0.64));
			sky += env_at(normalize(n + (t - b) * 0.64));
			sky += env_at(normalize(n - (t + b) * 0.64));
			sky += env_at(normalize(n - (t - b) * 0.64));
			c.rgb += s.albedo.rgb * sky / 10.0 * env_strength;
		} else {
			// The reflection, over the style's colour: some everywhere, more at grazing angles
			float3 e = env_at(reflect(-s.view, s.normal));
			float grazing = 0.25 + 0.75 * pow(1.0 - saturate(dot(s.normal, s.view)), 3.0);
			c.rgb = lerp(c.rgb, e, saturate(env_strength * grazing));
		}
	}
	// (Every map kept: see keep_maps)
	c.rgb += (emitted + nmap + mrmap) * keep_maps;
	// Opaque and cut-out materials are solid where they're drawn
	return float4(c.rgb, lerp(1.0, c.a, blended));
}

// The outline: the mesh pushed out along its normals, only where it faces
// away from the camera, so it shows around the avatar's edges. Jitter
// makes its width wander along the stroke; boil redraws that wander a
// few times a second, like a hand-drawn line
VertOut VSOutline(VertIn v)
{
	VertOut o;
	float seed = floor(time * outline_boil) * 17.0;
	float3 q = v.pos.xyz * 45.0;
	float wobble = sin(q.x + seed) * sin(q.y * 1.3 + seed * 1.7) * sin(q.z * 0.7 + seed * 2.3);
	// Thinner and thicker, never gone (a line that pinches to nothing breaks)
	float width = outline_width * max(0.4, 1.0 + outline_jitter * wobble);
	float3 p = v.pos.xyz + normalize(v.norm) * width;
	o.pos = mul(float4(p, 1.0), mvp);
	o.uv = v.uv;
	o.norm = v.norm;
	o.wpos = p;
	return o;
}

float4 PSOutline(VertOut v) : TARGET
{
	if (dot(normalize(v.norm), normalize(eye.xyz - v.wpos)) > 0.0)
		discard;
	if ((base_color * texel(v.uv)).a < alpha_cutoff || faded_out(v.pos.xy))
		discard;
	return float4(outline_color.rgb, 1.0);
}

// The parts map for Theater Scene (parts.rs): each pixel's body part + 1
// in red (0 = nothing there). Each vertex has one channel per part (1 for
// its own): across a triangle the strongest channel is always one of its
// corners' parts, never one in between
struct PartIn {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
	float4 p0  : TEXCOORD1;
	float4 p1  : TEXCOORD2;
	float4 p2  : TEXCOORD3;
};

struct PartOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
	float4 p0  : TEXCOORD1;
	float4 p1  : TEXCOORD2;
	float4 p2  : TEXCOORD3;
};

PartOut VSParts(PartIn v)
{
	PartOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), mvp);
	o.uv = v.uv;
	o.p0 = v.p0;
	o.p1 = v.p1;
	o.p2 = v.p2;
	return o;
}

float4 PSParts(PartOut v) : TARGET
{
	if ((base_color * texel(v.uv)).a < alpha_cutoff || faded_out(v.pos.xy))
		discard;
	float best = v.p0.x;
	float id = 0.0;
	if (v.p0.y > best) { best = v.p0.y; id = 1.0; }
	if (v.p0.z > best) { best = v.p0.z; id = 2.0; }
	if (v.p0.w > best) { best = v.p0.w; id = 3.0; }
	if (v.p1.x > best) { best = v.p1.x; id = 4.0; }
	if (v.p1.y > best) { best = v.p1.y; id = 5.0; }
	if (v.p1.z > best) { best = v.p1.z; id = 6.0; }
	if (v.p1.w > best) { best = v.p1.w; id = 7.0; }
	if (v.p2.x > best) { best = v.p2.x; id = 8.0; }
	if (v.p2.y > best) { best = v.p2.y; id = 9.0; }
	return float4((id + 1.0) / 255.0, 0.0, 0.0, 1.0);
}

technique Parts
{
	pass
	{
		vertex_shader = VSParts(v);
		pixel_shader  = PSParts(v);
	}
}

// The ink pass's view of the avatar (ink.effect): each pixel's normal and
// distance, for lines where they change sharply
struct GOut {
	float4 pos   : POSITION;
	float2 uv    : TEXCOORD0;
	float3 norm  : TEXCOORD1;
	float  depth : TEXCOORD2;
};

GOut VSGBuffer(VertIn v)
{
	GOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), mvp);
	o.uv = v.uv;
	o.norm = v.norm;
	o.depth = o.pos.w;
	return o;
}

float4 PSGBuffer(GOut v) : TARGET
{
	if ((base_color * texel(v.uv)).a < alpha_cutoff || faded_out(v.pos.xy))
		discard;
	return float4(normalize(v.norm) * 0.5 + 0.5, v.depth);
}

// The avatar's distance from the camera (metres, as theater_puppet_points'
// depth), one float a pixel: Theater Scene hides a 2D effect behind it
uniform float4x4 view_m;

struct DepthOut {
	float4 pos   : POSITION;
	float2 uv    : TEXCOORD0;
	float  depth : TEXCOORD1;
};

DepthOut VSDepth(VertIn v)
{
	DepthOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), mvp);
	o.uv = v.uv;
	o.depth = -mul(float4(v.pos.xyz, 1.0), view_m).z;
	return o;
}

float4 PSDepth(DepthOut v) : TARGET
{
	if ((base_color * texel(v.uv)).a < alpha_cutoff || faded_out(v.pos.xy))
		discard;
	return float4(v.depth, 0.0, 0.0, 1.0);
}

technique Depth
{
	pass
	{
		vertex_shader = VSDepth(v);
		pixel_shader  = PSDepth(v);
	}
}

technique GBuffer
{
	pass
	{
		vertex_shader = VSGBuffer(v);
		pixel_shader  = PSGBuffer(v);
	}
}

// The colliders shown (the source's "Show colliders"): plain lines, one colour
uniform float4 line_color;

struct LineIn {
	float4 pos : POSITION;
};

struct LineOut {
	float4 pos : POSITION;
};

LineOut VSLine(LineIn v)
{
	LineOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), mvp);
	return o;
}

float4 PSLine(LineOut v) : TARGET
{
	return line_color;
}

technique Lines
{
	pass
	{
		vertex_shader = VSLine(v);
		pixel_shader  = PSLine(v);
	}
}

technique Draw
{
	pass
	{
		vertex_shader = VSPuppet(v);
		pixel_shader  = PSPuppet(v);
	}
}

technique Outline
{
	pass
	{
		vertex_shader = VSOutline(v);
		pixel_shader  = PSOutline(v);
	}
}
